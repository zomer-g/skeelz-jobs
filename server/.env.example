# Local development only. On xhostd, DATABASE_URL and S3_* are injected and the
# rest is set with set_env / set_secret.
DATABASE_URL=postgresql://postgres@127.0.0.1:5437/postgres
DEV_MODE=true
NODE_ENV=development
ACCESS_TOKEN_SECRET=dev-access-secret-change-me-0123456789
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-0123456789
RESET_TOKEN_SECRET=dev-reset-secret-change-me-0123456789
CLIENT_BASE_URL=http://localhost:3000
# Integrations stay OFF in development (no real credentials, never production Salesforce).
ENABLE_SALESFORCE=false
# Salesforce settings (docs/salesforce.md). Locally ONLY the mock of test/e2e-salesforce.mjs (http://127.0.0.1 is honoured
# only with DEV_MODE=true); set ENABLE_SALESFORCE=true with these to run that suite. Never a real org from here.
# SALESFORCE_LOGIN_URL=http://127.0.0.1:3198
# SALESFORCE_CLIENT_ID=e2e-sf-client
# SALESFORCE_CLIENT_SECRET=e2e-sf-secret-not-real
# SALESFORCE_CONTACTS_ACCOUNT_ID=001000000000AAAAAA
# SALESFORCE_JOBAPPLICATIONS_ACCOUNT_ID=001000000000BBBBBB
# SALESFORCE_CASE_ACCOUNT_ID=001000000000CCCCCC
# SALESFORCE_EMPLOYER_ACCOUNT_RECORD_TYPE_ID=012000000000OrgAAA
# SALESFORCE_JOBAPPLICATIONS_CASE_RECORD_TYPE_ID=012000000000AppAAA
# SALESFORCE_CASE_RECORD_TYPE_ID=012000000000JobAAA
# The cutover from the existing site (docs/jobs-management.md "Jobs of the existing site"; test/e2e-cutover.mjs sets
# these itself). SALESFORCE_BETA_MARK=false stops writing the Beta mark. LEGACY_JOBS_MODE: off (default) / mirror (its
# jobs read from Salesforce, read-only here) / owned (managed here, written to the same Position Cases).
# SALESFORCE_BETA_MARK=true
# LEGACY_JOBS_MODE=off
# LEGACY_PUBLIC_API=https://jobs.skeelz.co.il/api      (GET only; locally only a mock, with DEV_MODE=true)
# LEGACY_JOBS_MIRROR_MINUTES=5
# The existing site's candidates (docs/salesforce.md 1ב; test/e2e-legacy-candidates.mjs sets these itself): off (default)
# / mirror (copied from Salesforce, view only here) / owned (ordinary candidates, their changes go to the same Contact).
# LEGACY_CANDIDATES_MODE=off
# LEGACY_CANDIDATES_MIRROR_MINUTES=60      (5–1440; everything is re-read once a day)
# LEGACY_CANDIDATE_ACCOUNTS=001000000000AAAAAA      (comma-separated; default SALESFORCE_CONTACTS_ACCOUNT_ID)
# JOB_NUMBER_FLOOR=3000      (jobs made here are numbered above the existing site's)
ENABLE_SMOOVE=false
SEND_EMAIL_ENABLED=false
# Email through Resend (docs/email-signin.md). Locally leave them unset: emails (and sign-in codes) are printed in the
# server console instead, and the e2e scripts read codes from the DEV_MODE-only /api/dev/email-code.
# Sign-in by a code by email (off in production until the owner verifies the Resend domain; the button is shown greyed).
EMAIL_CODE_SIGNIN_ENABLED=true
# RESEND_API_KEY=re_...            (xhostd: set_secret)
# EMAIL_FROM=SKEELZ <no-reply@mail.example>
# Resend's webhook (bounces, complaints → suppression; docs/mail.md). xhostd: set_secret. Locally only for test/e2e-mail.mjs.
# RESEND_WEBHOOK_SECRET=whsec_...
# First admin (dev values only). The admin sees security and staff users, never candidates.
ADMIN_EMAIL=admin@example.test
# Optional and unused for sign-in (nobody has password sign-in since 11.2026; staff sign in only with Google).
ADMIN_INITIAL_PASSWORD=dev-admin-password-123
# One-time role split of an existing DB: this account stays admin, other former admins become content managers.
# Defaults to ADMIN_EMAIL. On prod set it (set_env) to the owner's chosen account.
# INITIAL_ADMIN_EMAIL=
# A content manager for local testing (jobs + candidates). Only with DEV_MODE=true; never on prod.
CONTENT_MANAGER_EMAIL=content@example.test
CONTENT_MANAGER_INITIAL_PASSWORD=dev-content-password-123
# "Continue with Google" = xhostd SSO. Locally the e2e scripts play xhostd with a mock (server/test/helpers);
# the issuer/JWKS overrides are honoured only with DEV_MODE=true. Staff (admin, content manager) sign in ONLY this way.
SSO_ENABLED=true
SSO_ISSUER=http://127.0.0.1:3199
SSO_JWKS_URL=http://127.0.0.1:3199/jwks
# "Continue with Microsoft" (candidates only; docs/microsoft-sso.md). OFF unless ENABLE_MICROSOFT_SSO=true and both
# MS_CLIENT_ID (set_env) and MS_CLIENT_SECRET (set_secret) are set. Locally test/e2e-microsoft-sso.mjs plays Microsoft
# with the same mock as above; MS_LOGIN_BASE is honoured only with DEV_MODE=true.
ENABLE_MICROSOFT_SSO=true
MS_CLIENT_ID=e2e-ms-client
MS_CLIENT_SECRET=e2e-ms-secret
MS_LOGIN_BASE=http://127.0.0.1:3199
