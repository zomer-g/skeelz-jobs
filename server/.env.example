# Local development only. On xhostd, DATABASE_URL and S3_* are injected and the
# rest is set with set_env / set_secret.
DATABASE_URL=postgresql://postgres@127.0.0.1:5437/postgres
DEV_MODE=true
NODE_ENV=development
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
RESET_TOKEN_SECRET=dev-reset-secret-change-me
CLIENT_BASE_URL=http://localhost:3000
# Integrations stay OFF in development (no real credentials, never production Salesforce).
ENABLE_SALESFORCE=false
ENABLE_SMOOVE=false
SEND_EMAIL_ENABLED=false
# First admin (dev values only). The admin sees security and staff users, never candidates.
ADMIN_EMAIL=admin@example.test
# Optional (staff never sign in with a password); the local tests use it to prove a staff password is refused.
ADMIN_INITIAL_PASSWORD=dev-admin-password-123
# One-time role split of an existing DB: this account stays admin, other former admins become content managers.
# Defaults to ADMIN_EMAIL. On prod set it (set_env) to the owner's chosen account.
# INITIAL_ADMIN_EMAIL=
# A content manager for local testing (jobs + candidates). Only with DEV_MODE=true; never on prod.
CONTENT_MANAGER_EMAIL=content@example.test
CONTENT_MANAGER_INITIAL_PASSWORD=dev-content-password-123
# "Continue with Google" = xhostd SSO. Locally the e2e scripts play xhostd with a mock (server/test/helpers);
# the issuer/JWKS overrides are honoured only with DEV_MODE=true. Staff (admin, content manager) sign in ONLY this way.
SSO_ENABLED=true
SSO_ISSUER=http://127.0.0.1:3199
SSO_JWKS_URL=http://127.0.0.1:3199/jwks
